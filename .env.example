# DataForSEO credentials (https://app.dataforseo.com/api-access). Pick one form.
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=your-api-password
# DATAFORSEO_AUTH=Basic base64(login:password)

# Timezone for "today", display, and hour-of-day calibration bands.
FOF_TZ=America/Chicago

# How often the updater container grabs, in hours. 3 = eight grabs a day.
FOF_UPDATE_INTERVAL_HOURS=3

# Optional
# FOF_COMPANIES=Salesforce,Oracle,Workday
# FOF_LOOKBACK_DAYS=90
# FOF_DB_PATH=/data/productivity.db
